# Variables de entorno (Vercel → Settings → Environment Variables, marcar Production y Preview).
# Para trabajar en local, copia este archivo como .env.local.

# ── Supabase (Project Settings → API Keys) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Clave SECRETA (sb_secret_…). Solo en Vercel, nunca en el código ni en el chat.
# Permite crear cuentas y generar los enlaces de los correos que envía Resend.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Resend (resend.com → API Keys) ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente con un dominio verificado en Resend (Domains). Sin dominio verificado,
# Resend solo permite enviar al correo de la propia cuenta de Resend.
CORREO_REMITENTE=Academia Diana Gamboa <hola@tudominio.com>

# ── Web ────────────────────────────────────────────────────────────────
# Dirección pública (se usa en los enlaces de los correos).
NEXT_PUBLIC_SITE_URL=https://diana-gamboa.vercel.app
# Opcional: única cuenta administradora (por defecto dianapersonalinfo@gmail.com).
# ADMIN_CORREO=dianapersonalinfo@gmail.com

# Pagos de eventos con Stripe (Stripe → Developers → API keys y → Webhooks). Secretas: solo en Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
