# Copia este archivo como .env.local (en tu computador) o crea estas variables en
# Vercel → Settings → Environment Variables. Están en Supabase → Project Settings → API.

# Dirección del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública (publishable key, empieza por sb_publishable_…). Si tu proyecto es antiguo,
# usa en su lugar NEXT_PUBLIC_SUPABASE_ANON_KEY con la clave «anon public».
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Dirección pública de la web (para las imágenes al compartir enlaces)
NEXT_PUBLIC_SITE_URL=https://diana-gamboa.vercel.app
